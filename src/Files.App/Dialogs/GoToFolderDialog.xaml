<ContentDialog
	x:Class="Files.App.Dialogs.GoToFolderDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:models="using:Files.App.Data.Models"
	BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
	BorderThickness="1"
	CloseButtonText="Cancelar"
	CornerRadius="{StaticResource OverlayCornerRadius}"
	DefaultButton="None"
	PrimaryButtonText=""
	SecondaryButtonText=""
	Style="{ThemeResource DefaultContentDialogStyle}">

	<ContentDialog.Resources>
		<DataTemplate x:Key="FolderItemTemplate" x:DataType="models:VisitedFolderItem">
			<Grid
				Height="48"
				Padding="8,6"
				ColumnSpacing="12">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>

				<FontIcon
					Grid.Column="0"
					FontSize="20"
					Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
					Glyph="&#xED43;" />

				<StackPanel Grid.Column="1" VerticalAlignment="Center">
					<TextBlock
						FontSize="14"
						FontWeight="SemiBold"
						Text="{x:Bind FolderName}"
						TextTrimming="CharacterEllipsis" />
					<TextBlock
						Foreground="{ThemeResource TextFillColorSecondaryBrush}"
						Style="{ThemeResource CaptionTextBlockStyle}"
						Text="{x:Bind FolderPath}"
						TextTrimming="CharacterEllipsis" />
				</StackPanel>
			</Grid>
		</DataTemplate>
	</ContentDialog.Resources>

	<Grid Width="460" RowSpacing="12">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="300" />
		</Grid.RowDefinitions>

		<!--  Cuadro de búsqueda  -->
		<TextBox
			x:Name="SearchBox"
			Grid.Row="0"
			PlaceholderText="Escribe el nombre de una carpeta..."
			PreviewKeyDown="SearchBox_PreviewKeyDown"
			TextChanged="SearchBox_TextChanged">
			<TextBox.Header>
				<TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Ir a carpeta reciente" />
			</TextBox.Header>
		</TextBox>

		<!--  Lista de coincidencias  -->
		<ListView
			x:Name="FoldersListView"
			Grid.Row="1"
			IsItemClickEnabled="True"
			ItemClick="FoldersListView_ItemClick"
			ItemTemplate="{StaticResource FolderItemTemplate}"
			KeyDown="FoldersListView_KeyDown"
			SelectionMode="Single" />
	</Grid>
</ContentDialog>
